<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episode_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_episode_item_inactive"
    android:clickable="true"
    android:focusable="true">

    <!-- Episode Thumbnail with 16:9 ratio and Rounded Corners -->
    <androidx.cardview.widget.CardView
        android:layout_width="114dp"
        android:layout_height="64dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1A1A22">

        <ImageView
            android:id="@+id/ep_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@drawable/example_poster" />

        <!-- Overlay play icon badge -->
        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_circle_badge">

            <ImageView
                android:id="@+id/ep_play_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_play_arrow_24"
                tools:ignore="ContentDescription"
                app:tint="@android:color/white" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Episode Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ep_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="1. Winter Is Coming" />

        <TextView
            android:id="@+id/ep_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#9292A0"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Ned Stark is torn between his lordly duty and the king's request..." />
    </LinearLayout>

</LinearLayout>
